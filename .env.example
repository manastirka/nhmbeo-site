# Copy to `.env.local` and fill in. Anything prefixed with NEXT_PUBLIC_ ends
# up in the browser bundle.

NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Hostinger FTP/SFTP — see hPanel → FTP Accounts.
# Prefer DEPLOY_PROTOCOL=sftp (Hostinger port 65002) and a hostname, not a raw IP.
DEPLOY_PROTOCOL="ftp"
FTP_HOST=""
FTP_PORT="21"
SFTP_PORT="65002"
FTP_USER=""
FTP_PASSWORD=""
FTP_REMOTE_PATH="public_html"

# Production static form (Hostinger PHP). Local `next dev` can omit this
# and will post to /api/newsletter instead.
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT="/newsletter.php"

# Google Search Console / Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
